{
  "name": "root",
  "private": true,
  "packageManager": "npm@10.7.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start:frontend": "dotenv -- turbo run dev --scope='frontend'",
    "start:backend": "dotenv -- turbo run dev --scope='backend'",
    "dev": "dotenv -- turbo run dev ",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "dotenv-cli": "^7.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.10.12"
  },
  "dependencies": {
    "react-icons": "^5.5.0"
  },
  "overrides": {
    "vitest": "3.2.7",
    "@vitest/browser": "3.2.7",
    "uuid": "11.1.1"
  }
}
